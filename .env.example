# Connection to POSTGRES_DB
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow

DATA_SOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Connection to REDIS
REDIS_HOST=localhost
REDIS_PORT=6379

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8081
KEYCLOAK_BASE_URL=http://localhost:${KEYCLOAK_PORT}
KEYCLOAK_REALM=taskflow
KEYCLOAK_ADMIN_CLIENT_ID=taskflow-admin
KEYCLOAK_ADMIN_SECRET=secret_of_client_taskflow_admin

# Token of localstack
LOCALSTACK_PORT=4566
LOCALSTACK_AUTH_TOKEN=localstack_auth_token

# AWS
AWS_DYNAMODB_ENDPOINT=http://localhost:${LOCALSTACK_PORT}
AWS_DYNAMODB_REGION=us-east-1
AWS_DYNAMODB_ACCESS_KEY_ID=local
AWS_DYNAMODB_SECRET_ACCESS_KEY=local
AWS_DYNAMODB_TABLE_NAME=TaskflowEvents
